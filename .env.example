# Copy to .env (never commit .env). `python scripts/generate_secrets.py` does this for you
# and fills the two secrets in BOTH .env and mcp-server/.env with matching random values.

# Local LLM on the host (Ollama). From inside Docker the host is host.docker.internal.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2

# Host MCP server (see docs/MCP_SETUP.md). Leave empty to disable the workspace feature.
MCP_SERVER_URL=http://host.docker.internal:8765/mcp
MCP_AUTH_TOKEN=replace-with-generated-token
# Shared with the MCP server; used to sign one-time human-approval tokens.
JARVIS_APPROVAL_SECRET=replace-with-generated-secret
