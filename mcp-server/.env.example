# Host-side MCP server settings (copy to mcp-server/.env; never commit it).
# The ONE directory J.A.R.V.I.S. may access. Use an absolute path to a project folder.
#   Windows example: MCP_ALLOWED_ROOT=C:\Users\you\projects\demo-project
MCP_ALLOWED_ROOT=../sample-data/demo-project
# Docker Desktop (Windows/macOS): keep 127.0.0.1.  Linux Docker Engine: use the docker0 gateway, e.g. 172.17.0.1
MCP_HOST=127.0.0.1
MCP_PORT=8765
MCP_AUTH_TOKEN=replace-with-generated-token
JARVIS_APPROVAL_SECRET=replace-with-generated-secret
# Optional: JSON command allow-list stored OUTSIDE the authorized project
# MCP_COMMANDS_FILE=C:\Users\you\jarvis-mcp-commands.json
